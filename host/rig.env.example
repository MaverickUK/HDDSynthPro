# Settings for this rig, loaded by scripts/rig.sh. Copy to host/rig.env
# (git-ignored) and adjust; locations are specific to each machine and port.
# List hubs and ports with: uhubctl

# Hands-free replugs: the NS1081 adapter on port 4 of the Realtek RTS5411
# hub (0bda:0411 USB 3 half, 0bda:5411 USB 2 half). -e is needed on macOS.
export HDDPRO_UHUBCTL="-l 0-2 -e -p 4;-l 0-1 -e -p 4"

# How long the port stays off during a replug, seconds.
export HDDPRO_REPLUG_OFF_S=2
