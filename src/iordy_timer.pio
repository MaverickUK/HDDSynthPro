; Drive build: times each read from the host's side, as a check on the bus
; program. The host waits from DIOR# falling until IORDY is high again, and
; ATA allows IORDY to hold a read for at most 1250 ns (tB). This program
; only reads pins, so it can run alongside ide_bus and never drives anything.
;
; Pin mapping (see iordy_timer.cpp):
;   IN_BASE      = GPIO4 (DD0), as in bus_sample.h
;   wait gpio 26 = DIOR#
;   JMP_PIN      = GPIO28 (IORDY)
;
; Only reads slower than a threshold are reported, so the RX FIFO stays empty
; while all is well. The threshold, in loop iterations of 2 cycles, is put in
; the TX FIFO once at start. Each report is one word:
;   bits 31-16  0xFFFF minus the further 2-cycle iterations IORDY stayed low
;   bits 15-0   pin sample bits 31-16, taken as DIOR# fell: DA2-0 in bits
;               2-0, CS0# in bit 3, CS1# in bit 4 (which register was read)
;
; A read that starts while IORDY is still high is reported at once, untimed:
; ide_bus pulls IORDY low before every strobe, so the host might not wait for
; the data. Its sample has the IORDY bit (bit 8 of the report) set.

.pio_version 1
.program iordy_timer
    pull block              ; the threshold, once
.wrap_target
    wait 0 gpio 26          ; DIOR# falls: the host starts a read
    mov isr, pins           ; which register, and IORDY (kept for a report)
    jmp pin early           ; IORDY still high as the read starts
    mov y, osr
fast:
    jmp pin done            ; IORDY high: the host has its data
    jmp y-- fast
    mov x, ~null            ; slower than the threshold: count on
slow:
    jmp pin report
    jmp x-- slow
report:
    in x, 16                ; the count's low half on top of the register bits
    push noblock            ; a full FIFO drops it; core 0 drains it often
done:
    wait 1 gpio 26          ; DIOR# rises
.wrap
early:
    in null, 16             ; the register bits, with IORDY's set
    push noblock
    jmp done
