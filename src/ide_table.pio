; The register table (docs/register-table.md): every read answered at its
; strobe from values core 1 keeps ready, so nothing on the read path waits
; for core 1. Block 0, which owns DD0-15 and IORDY.
;
; Pin mapping (ide_table.cpp; bit numbers as in bus_sample.h):
;   IN_BASE  = GPIO20 (DA0), IN_COUNT 5: a pin read is the address alone,
;              DA0-2, CS0#, CS1# (bits 0-4), the higher bits read as 0
;   OUT_BASE = GPIO4, 16 pins: DD0-15
;   JMP_PIN  = wait gpio 26 = DIOR#
;
; ---- R0-R2: the registers ------------------------------------------------------
;
; Three state machines run this program, each serving four addresses from its
; RX FIFO, which `.fifo txget` turns into four registers that core 1 (or a DMA
; channel) writes and the program reads in one cycle:
;   R0  CS0#, DA2 = 0: 0 Data (always empty: D serves it), 1 Error,
;       2 Sector Count, 3 LBA Low
;   R1  CS0#, DA2 = 1: 0 LBA Mid, 1 LBA High, 2 Device, 3 Status
;   R2  CS1#, DA2 = 1: 0-1 not the drive's, 2 Alternate Status, 3 Drive Address
; Each entry is the word ide_bus's core 1 answers with: bits 0-15 the value
; for DD0-15, bits 16-31 which of them to drive (all). An empty entry (0) is an
; address that isn't this state machine's to answer: it doesn't touch DD at
; all, not even the output latch, which D may be writing for the same read.
;
; ISR holds the state machine's claim, loaded once by the C side: DA2, CS0#
; and CS1# (R0 4, R1 5, R2 3). Nothing else uses ISR.
;
; The answer is ready before the strobe: the state machine whose address is
; on the bus spins, watching the address and DIOR#, and drives DD within about
; 30 ns of DIOR# falling. The register table first answered from the strobe,
; about 90 ns on (12 Nov 2026).
;
; While DIOR# is low the outputs follow the bus, as a drive's do (its register
; outputs are gates on the address and DIOR#, not something decided at the
; strobe): each pass of `hold`, 6 cycles, re-reads the entry and puts it on DD,
; and lets go as soon as the address is no longer this entry's. So:
;   - a host whose address settles after its strobe gets the register the
;     address ends on. The Innostor bridge goes from Status to Data with the
;     address changing as DIOR# falls, and the PIIX in compatible timing does
;     the same; decided once, 2 cycles after the strobe, a read whose address
;     settled 10 ns later was answered as Status, or by nobody, and the data
;     block ran one word late from there (simulated, 12 Nov 2026);
;   - a host that holds one long strobe sees Status change under it.
; DIOR# skips the input synchroniser and the address doesn't, so the address
; is first looked at as of 2 cycles after the strobe, never before D's look: if
; D takes the read for the data register, no register is driven over it. DD's
; output latch may be written (`out pins`) for a read that turns out to be
; D's: D writes it later (cycle 6 after the strobe against 5 at most here).
; Released up to 35 ns after DIOR# rises (a pass of `hold` and an instruction;
; t6z allows 30), typically 15-20.
.pio_version 1
.program ide_table_reg
.fifo txget
public sample:
    mov osr, pins                   ; the address
    out null, 2                     ; DA0-1
    mov x, osr                      ; DA2, CS0#, CS1#
    mov y, isr                      ; my claim
    jmp x!=y sample                 ; another state machine's, or nobody's
    mov y, pins                     ; the address: DA1-0 pick the entry
    mov osr, rxfifo[y]
    mov x, osr
    jmp !x sample                   ; an empty entry: not the drive's, or D's (the data register)
release:                            ; (also passed on the way in from `sample`, where it changes
    mov pindirs, null               ; nothing: no read of this entry is under way) release DD0-15
spin:                               ; my address is on the bus: until DIOR# falls, or it moves on
    mov x, pins
    jmp x!=y sample
    jmp pin spin
.wrap_target
hold:                               ; DIOR# low: follow the entry and the address
    mov osr, rxfifo[y]              ; the entry as it is now
    out pins, 16                    ; onto DD's output latch
    mov x, pins                     ; the address: first as of 2 cycles after the strobe
    jmp x!=y release                ; not this entry's (any more): let go
    out pindirs, 16                 ; drive DD
    jmp pin release                 ; DIOR# has risen
.wrap

; ---- D: IORDY, and the data register ------------------------------------------
;
; IORDY (side-set, as a pin direction: its output value is preset to 0, so the
; pin is only ever pulled low or released) goes low at each register read, for
; a host that waits, until R0-R2 have answered; never at a chip select (an ISA
; card's address-only cycles can't stall on it), and never on a data read,
; which D answers within about 35 ns. The Innostor bridge's IORDY takes about a
; microsecond to rise once released: held for every data word (1.3 us each),
; the bridge gave up on each sector part-way (12 Nov 2026). DIOR# skips the
; input synchroniser in this block (ide_table.cpp), so IORDY falls inside tA;
; the address doesn't, so a host whose address is valid before its strobe (t1,
; 25 ns or more for every host that waits) is decoded right.
;
; The data register: the next word from the TX FIFO, which a DMA channel keeps
; filled from the block, as the data lane's ide_data_in has it (an 8-deep TX
; FIFO, the word in each half). After the block the channel adds one spare
; word, never pulled: the FIFO holding just that is how core 1 knows the host
; has read the whole block. The channel's completion starts the busy write.
;
; IN_BASE and IN_COUNT as R0-R2's: a pin read is the address. Y holds the
; data register's (DA2-0 = 0, CS0# low, CS1# high: 16), set by the C side.
; JMP_PIN is DIOR#.
;
; A read that starts as a register's can become the data register's while
; DIOR# is still low (the address settling after the strobe, see R0-R2): `again`
; looks at the address every 8 cycles, first with IORDY still low, and answers
; with the next word when it is the data register's; IORDY is released once the
; word has been on DD for 25 ns. It notices DIOR# rising up to 45 ns late,
; inside every mode's recovery time but PIO 4's (25 ns).
.program ide_table_data
.side_set 1 opt pindirs
regs:                               ; a register: IORDY low until R0-R2 have answered
    nop                     side 1 [7]  ; (from about 25 ns after the strobe, inside tA's 35,
again:                              ; for 80 ns)
    mov x, pins                    [5]
    jmp x!=y isreg                  ; still a register's; else the data register after all:
.wrap_target
    pull noblock                    ; the next word (outside a block: X, junk, as a real
                                    ; drive gives; a blocking pull held IORDY for good)
    out pins, 16
    mov pindirs, ~null             [3]  ; drive DD0-15, about 35 ns after DIOR# fell
    wait 1 gpio 26          side 0  ; hold the word until DIOR# rises (IORDY released, if it was low)
    mov pindirs, null               ; release DD0-15
public top:
    wait 0 gpio 26          [2]     ; DIOR# falls (unsynchronised): a read
    mov x, pins                     ; its address, as of 2 cycles after the strobe (the synchroniser's
                                    ; 2 cycles)
    jmp x!=y regs                   ; not the data register (yet)
.wrap
public isreg:                       ; (core 1 restarts D here when a read is under way)
    jmp pin top             side 0  ; IORDY released; DIOR# has risen: the next read
    jmp again                       ; still low: the address may yet become the data register's
