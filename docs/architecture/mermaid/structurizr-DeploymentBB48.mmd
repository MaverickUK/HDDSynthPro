graph LR
  linkStyle default fill:#ffffff

  subgraph diagram ["Deployment View: IDE Synth Bay - BB48"]
    style diagram fill:#ffffff,stroke:#ffffff

    subgraph 143 ["Olimex RP2350-PICO2-BB48"]
      style 143 fill:#ffffff,stroke:#444444,color:#444444

      subgraph 144 ["RP2350B"]
        style 144 fill:#ffffff,stroke:#444444,color:#444444

        145["<div style='font-weight: bold'>Core 1: bus loop</div><div style='font-size: 70%; margin-top: 0px'>[Container: C++ (Arduino-Pico), RAM-resident]</div><div style='font-size: 80%; margin-top:10px'>The real-time half. Answers<br />every register access the PIO<br />hands it, runs the ATA/ATAPI<br />command state machines,<br />starts DMA bursts. Never<br />waits: everything it runs per<br />access is in RAM (CORE1_RAM),<br />never touches USB or the<br />card.</div>"]
        style 145 fill:#438dd5,stroke:#2e6295,color:#ffffff
        146["<div style='font-weight: bold'>Core 0: services</div><div style='font-size: 70%; margin-top: 0px'>[Container: C++ (Arduino-Pico)]</div><div style='font-size: 80%; margin-top:10px'>Everything slow: the card,<br />USB serial, the activity<br />link, the diagnostics'<br />reports, the bus = auto<br />advice. Keeps up with core<br />1's fetches before anything<br />else.</div>"]
        style 146 fill:#438dd5,stroke:#2e6295,color:#ffffff
        149["<div style='font-weight: bold'>PIO programs</div><div style='font-size: 70%; margin-top: 0px'>[Container: RP2350 PIO assembly (src/*.pio)]</div><div style='font-size: 80%; margin-top:10px'>State machines that meet the<br />IDE bus's nanosecond timing:<br />sample every access, pull<br />IORDY low within 35 ns, drive<br />DD for reads, move DMA data.<br />Three blocks of 32<br />instructions.</div>"]
        style 149 fill:#2e7d5b,stroke:#20573f,color:#ffffff
      end

      subgraph 153 ["microSD breakout"]
        style 153 fill:#ffffff,stroke:#444444,color:#444444

        154[("<div style='font-weight: bold'>microSD card</div><div style='font-size: 70%; margin-top: 0px'>[Container: FAT32]</div><div style='font-size: 80%; margin-top:10px'>FAT32: disk images<br />(HDDSYNTH.IMG and others),<br />ISOs and BIN/CUEs,<br />HDDSYNTH.INI, the scratch<br />HDDBENCH.IMG. Holds the<br />owner's data: the firmware<br />only touches the image<br />served, HDDBENCH.IMG and<br />HDDSYNTH.INI.</div>")]
        style 154 fill:#438dd5,stroke:#2e6295,color:#ffffff
      end

    end

    subgraph 156 ["USB-IDE adapter or retro PC"]
