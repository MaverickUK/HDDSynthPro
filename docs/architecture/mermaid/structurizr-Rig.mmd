        35["<div style='font-weight: bold'>Drive log and trace parser</div><div style='font-size: 70%; margin-top: 0px'>[Component: drive_log.py, trace.py]</div><div style='font-size: 80%; margin-top:10px'>Reads the board's serial<br />console, parses CMD/DONE/EV<br />lines.</div>"]
        style 35 fill:#85bbf0,stroke:#5d82a8,color:#000000
        36["<div style='font-weight: bold'>Host disk access</div><div style='font-size: 70%; margin-top: 0px'>[Component: host.py, host_macos.py, host_windows.py]</div><div style='font-size: 80%; margin-top:10px'>Raw reads and writes to the<br />emulated disk through the<br />adapter, per OS.</div>"]
        style 36 fill:#85bbf0,stroke:#5d82a8,color:#000000
